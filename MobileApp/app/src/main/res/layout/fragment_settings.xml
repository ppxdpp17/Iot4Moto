<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Contactos SOS (Adicionar prefixo)"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginBottom="16dp"/>

        <EditText
            android:id="@+id/etPhone1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Número 1"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            android:inputType="phone"
            android:backgroundTint="#555555"/>

        <EditText
            android:id="@+id/etPhone2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Número 2 (Opcional)"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            android:inputType="phone"
            android:backgroundTint="#555555"/>

        <EditText
            android:id="@+id/etPhone3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Número 3 (Opcional)"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            android:inputType="phone"
            android:backgroundTint="#555555"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mensagem de Emergência"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/etSosMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Tive um acidente com a mota."
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            android:inputType="textMultiLine"
            android:lines="3"
            android:backgroundTint="#555555"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Preferências de Notificação"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"/>

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/swAlertFall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ativar Alerta de Queda (SOS)"
            android:textColor="#FFFFFF"/>

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/swAlertTheft"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ativar Alerta de Furto"
            android:textColor="#FFFFFF"/>

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/swAlertRain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ativar Alerta de Chuva"
            android:textColor="#FFFFFF"/>

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/swAlertFcw"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ativar FCW (Colisão Frontal)"
            android:textColor="#FFFFFF"/>

        <Button
            android:id="@+id/btnSaveSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Guardar Definições"
            android:layout_marginTop="24dp"
            android:backgroundTint="#333333"
            android:textColor="#FFFFFF"/>

    </LinearLayout>
</ScrollView>