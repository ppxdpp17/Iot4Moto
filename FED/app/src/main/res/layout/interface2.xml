<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroundColor"
    tools:context=".MainInterface2Activity">

    <!-- THIS LAYOUT CONTAINS THE TOP LAYOUTS (time_weather, indicatorContainer, dashboardIcons) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_chainStyle="spread">

        <!-- THIS LAYOUT CONTAINS THE TIME, WEATHER AND BLUETOOTH ICONS -->
        <LinearLayout
            android:id="@+id/time_weather"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/indicatorContainer"
            app:layout_constraintHorizontal_weight="1" >

            <TextView
                android:id="@+id/time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/agencyfb"
                android:gravity="center_horizontal|center_vertical"
                android:text="13 : 34 PM"
                android:textColor="#FFFFFF"
                android:textSize="28sp" />

            <ImageView
                android:id="@+id/weatherIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="30dp"
                app:srcCompat="@drawable/weathericon" />

            <TextView
                android:id="@+id/temperatureDisplay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:fontFamily="@font/agencyfb"
                android:gravity="center_horizontal|center_vertical"
                android:text="25 ºC"
                android:textColor="#FFFFFF"
                android:textSize="28sp" />

            <ImageView
                android:id="@+id/bluetooth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="30dp"
                app:srcCompat="@drawable/bluetooth" />
        </LinearLayout>

        <!-- THIS LAYOUT CONTAINS THE TURN INDICATORS -->
        <LinearLayout
            android:id="@+id/indicatorContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/turncontainer"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/time_weather"
            app:layout_constraintEnd_toStartOf="@id/dashboardIcons"
            app:layout_constraintHorizontal_weight="1">

            <ImageView
                android:id="@+id/leftTurnSignal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:srcCompat="@drawable/leftturn" />

            <ImageView
                android:id="@+id/rightTurnSignal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                app:srcCompat="@drawable/rightturn" />
        </LinearLayout>

        <!-- THIS LAYOUT CONTAINS THE DASHBOARD ICONS (LIGHTS, ABS AND ENGINE) -->
        <LinearLayout
            android:id="@+id/dashboardIcons"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/indicatorContainer"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="1" >

            <ImageView
                android:id="@+id/mediums"
                android:layout_width="73dp"
                android:layout_height="57dp"
                app:srcCompat="@drawable/mediums" />

            <ImageView
                android:id="@+id/highBeam"
                android:layout_width="73dp"
                android:layout_height="57dp"
                android:layout_marginStart="20dp"
                app:srcCompat="@drawable/highbeam" />

            <ImageView
                android:id="@+id/abs"
                android:layout_width="73dp"
                android:layout_height="57dp"
                android:layout_marginStart="20dp"
                app:srcCompat="@drawable/abs" />

            <ImageView
                android:id="@+id/engine"
                android:layout_width="73dp"
                android:layout_height="57dp"
                android:layout_marginStart="20dp"
                app:srcCompat="@drawable/enginelight" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

