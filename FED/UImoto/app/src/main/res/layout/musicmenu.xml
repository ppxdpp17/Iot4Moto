<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroundColor"
    android:fadingEdge="horizontal|vertical"
    android:fadingEdgeLength="5sp"
    tools:context=".MusicActivity">

    <LinearLayout
        android:id="@+id/linearLayout3"
        android:layout_width="380dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="20sp"
        android:gravity="center"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/agencyfb"
            android:text="13 : 34 PM"
            android:textColor="#FFFFFF"
            android:textSize="40sp" />

        <ImageView
            android:id="@+id/weatherIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="25dp"
            app:srcCompat="@drawable/weathericon" />

        <TextView
            android:id="@+id/temperatureDisplay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:fontFamily="@font/agencyfb"
            android:gravity="center_horizontal|center_vertical"
            android:text="25 ºC"
            android:textColor="#FFFFFF"
            android:textSize="40sp" />

        <ImageView
            android:id="@+id/bluetooth"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            app:srcCompat="@drawable/bluetooth" />
    </LinearLayout>

    <!-- THIS LAYOUT CONTAINS THE TURN INDICATORS -->

    <LinearLayout
        android:id="@+id/indicatorContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/turncontainer"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/linearLayout3"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/leftTurnSignalMusic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:srcCompat="@drawable/leftturn" />

        <ImageView
            android:id="@+id/rightTurnSignalMusic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            app:srcCompat="@drawable/rightturn" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/linearLayout5"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="@color/darkGray"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1.0">

        <TextView
            android:id="@+id/speedValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:fontFamily="@font/agencyfb"
            android:text="100 KM/H"
            android:textColor="@color/white"
            android:textSize="60sp" />

        <ImageView
            android:id="@+id/speedometerBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="20dp"
            app:srcCompat="@drawable/gpsvaluebar" />

        <TextView
            android:id="@+id/batteryValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:fontFamily="@font/agencyfb"
            android:text="85%"
            android:textColor="@color/white"
            android:textSize="60sp" />

        <ImageView
            android:id="@+id/batteryBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="20dp"
            app:srcCompat="@drawable/gpsvaluebar" />

        <ImageView
            android:id="@+id/mediums"
            android:layout_width="73dp"
            android:layout_height="57dp"
            android:layout_marginEnd="20dp"
            app:srcCompat="@drawable/mediums" />

        <ImageView
            android:id="@+id/highBeam"
            android:layout_width="73dp"
            android:layout_height="57dp"
            android:layout_marginEnd="20dp"
            app:srcCompat="@drawable/highbeam" />

        <ImageView
            android:id="@+id/abs"
            android:layout_width="73dp"
            android:layout_height="57dp"
            android:layout_marginEnd="20dp"
            app:srcCompat="@drawable/abs" />

        <ImageView
            android:id="@+id/engine"
            android:layout_width="73dp"
            android:layout_height="57dp"
            android:layout_marginEnd="30dp"
            app:srcCompat="@drawable/enginelight" />

        <TextView
            android:id="@+id/gearValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/agencyfb"
            android:text="D"
            android:textColor="#FFFFFF"
            android:textSize="60sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/linearLayout4"
        android:layout_width="188dp"
        android:layout_height="100dp"
        android:layout_marginStart="44dp"
        android:layout_marginTop="68dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout3">

        <ImageView
            android:id="@+id/musicNote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:srcCompat="@drawable/musicnote" />

        <TextView
            android:id="@+id/musicLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/agencyfb"
            android:text="@string/music_label"
            android:textColor="@color/lightBlue"
            android:textSize="40sp" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/songRecyclerView"
        android:layout_width="500dp"
        android:layout_height="400dp"
        android:layout_marginStart="44dp"
        app:layout_constraintBottom_toTopOf="@+id/linearLayout5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout4"
        app:layout_constraintVertical_bias="0.349" />

    <LinearLayout
        android:id="@+id/rightPanel"
        android:layout_width="500dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="164dp"
        android:layout_marginTop="196dp"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@+id/linearLayout5"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.234"
        app:layout_constraintStart_toEndOf="@+id/songRecyclerView"
        app:layout_constraintTop_toBottomOf="@+id/indicatorContainer"
        app:layout_constraintVertical_bias="0.096">

        <TextView
            android:id="@+id/songTitleRight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Title"
            android:textColor="#FFFFFF"
            android:textSize="50sp" />

        <TextView
            android:id="@+id/songArtistRight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Artist"
            android:textColor="@color/lightGray"
            android:textSize="30sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/backButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:srcCompat="@drawable/backarrow" />

            <ImageView
                android:id="@+id/pauseButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:srcCompat="@drawable/pause" />

            <ImageView
                android:id="@+id/skipButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:srcCompat="@drawable/skip" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/songProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/agencyfb"
                android:text="1:57"
                android:textColor="@color/lightGray"
                android:textSize="20sp" />


            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toStartOf="@id/songDurationRight"
                app:layout_constraintStart_toStartOf="@id/musicProgress">

                <ImageView
                    android:id="@+id/musicLine"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/line" />

                <ImageView
                    android:id="@+id/musicProgress"
                    android:layout_width="330dp"
                    android:layout_height="75dp"
                    android:layout_marginTop="3dp"
                    android:layout_marginEnd="40dp"
                    app:layout_constraintBottom_toBottomOf="@id/musicLine"
                    app:layout_constraintEnd_toEndOf="@id/musicLine"
                    app:layout_constraintStart_toStartOf="@id/musicLine"
                    app:layout_constraintTop_toTopOf="@id/musicLine"
                    app:srcCompat="@drawable/progressbar" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:id="@+id/songDurationRight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/agencyfb"
                android:text="3:37"
                android:textColor="@color/lightGray"
                android:textSize="20sp" />

        </LinearLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/volumeLine"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/line" />

            <ImageView
                android:id="@+id/volumeProgress"
                android:layout_width="330dp"
                android:layout_height="75dp"
                android:layout_marginTop="3dp"
                android:layout_marginEnd="40dp"
                app:layout_constraintBottom_toBottomOf="@id/volumeLine"
                app:layout_constraintEnd_toEndOf="@id/volumeLine"
                app:layout_constraintStart_toStartOf="@id/volumeLine"
                app:layout_constraintTop_toTopOf="@id/volumeLine"
                app:srcCompat="@drawable/progressbar" />


            <ImageView
                android:id="@+id/volumeIcon"
                android:layout_width="60dp"
                android:layout_height="35dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/volumeLine"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/volumeicon" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/textView4"
        android:layout_width="338dp"
        android:layout_height="150dp"
        android:fontFamily="@font/agencyfb"
        android:gravity="center_horizontal|center_vertical"
        android:text="@string/sensor_collision"
        android:textColor="#FFFFFF"
        android:textSize="40sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/indicatorContainer"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>