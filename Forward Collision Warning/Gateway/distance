#!/usr/bin/env python3
import time
import math
import json
import requests
import paho.mqtt.client as mqtt
import RPi.GPIO as GPIO
import numpy as np
from collections import deque

# --- CONFIGURAÇÃO ---
# Ajusta este valor! Poe o carro a 1.0m. Ve a largura em pixeis (W). Scale = 1.0 * W.
# Exemplo: Se a 1m o carro tem 100px de largura, Scale = 100.
CALIB_SCALE = 100.0  
SWITCH_TO_ULTRASOUND_M = 0.8  # Distancia para trocar para US (80cm)

MQTT_BROKER = "172.20.0.130"
TOPIC_RADAR = "fcw/radar"
TOPIC_ALERTA = "fcw/alerta"

FUNC_RESULT_URL = "http://10.254.239.1/func/result" # Tenta /v1/func/result se falhar

TRIG_PIN = 23
ECHO_PIN = 24

# Filtros
HISTORY_LEN = 5
history = deque(maxlen=HISTORY_LEN) # Guarda (tempo, distancia)

# --- SETUP HARDWARE ---
GPIO.setmode(GPIO.BCM)
GPIO.setup(TRIG_PIN, GPIO.OUT)
GPIO.setup(ECHO_PIN, GPIO.IN)
GPIO.output(TRIG_PIN, False)

mqtt_client = mqtt.Client()
try:
    mqtt_client.connect(MQTT_BROKER, 1883, 60)
    mqtt_client.loop_start()
except:
    print("Erro MQTT - a rodar offline")

# --- FUNÇÕES SENSOR ---
def read_hcsr04():
    try:
        GPIO.output(TRIG_PIN, True)
        time.sleep(0.00001)
        GPIO.output(TRIG_PIN, False)
        
        start = time.time()
        timeout = start + 0.04
        while GPIO.input(ECHO_PIN) == 0 and time.time() < timeout: start = time.time()
        
        pulse_end = time.time()
        timeout = pulse_end + 0.04
        while GPIO.input(ECHO_PIN) == 1 and time.time() < timeout: pulse_end = time.time()
        
        dist = (pulse_end - start) * 17150
        return dist / 100.0 # Metros
    except: return None

def get_camera_data():
    try:
        r = requests.get(FUNC_RESULT_URL, timeout=0.2)
        if r.status_code == 200:
            data = r.json()
            # Procura por 'obj' (firmware novo) ou 'result' (antigo)
            objs = data.get("obj", data.get("result", []))
            if objs:
                # Pega no maior objeto (mais proximo)
                best = max(objs, key=lambda x: x.get("w", 0))
                return best.get("w", 0)
    except: pass
    return None

# --- CÁLCULO FÍSICA ---
def calculate_dynamics(new_dist, new_time):
    history.append((new_time, new_dist))
    if len(history) < 3: return 0, 999 # Sem dados suficientes
    
    # Regressão linear simples para velocidade (m/s)
    # Declive negativo = aproximação
    times = np.array([t for t, d in history])
    dists = np.array([d for t, d in history])
    
    if np.max(times) - np.min(times) < 0.01: return 0, 999
    
    slope, _ = np.polyfit(times, dists, 1)
    vel = slope # m/s (negativo = aproximar)
    
    ttc = 999
    if vel < -0.1: # Se velocidade aproximação > 10cm/s
        ttc = new_dist / abs(vel)
        
    return vel, ttc

# --- MAIN ---
print("FCW Iniciado. Calibra o CALIB_SCALE se as distancias estiverem erradas.")
try:
    while True:
        now = time.time()
        
        # 1. Ler Camara
        w_px = get_camera_data()
        dist_cam = (CALIB_SCALE / w_px) if (w_px and w_px > 0) else None
        
        final_dist = None
        source = "NONE"
        
        # 2. Logica de Fusão
        # Se a camara diz que esta perto, ou se nao ha camara, tenta US
        if (dist_cam and dist_cam < SWITCH_TO_ULTRASOUND_M) or (dist_cam is None):
            dist_us = read_hcsr04()
            if dist_us and dist_us < 4.0:
                final_dist = dist_us
                source = "US"
            elif dist_cam:
                final_dist = dist_cam
                source = "CAM"
        elif dist_cam:
            final_dist = dist_cam
            source = "CAM"
            
        # 3. Processar
        if final_dist:
            vel, ttc = calculate_dynamics(final_dist, now)
            
            # Debug local limpo
            print(f"[{source}] Dist: {final_dist:.2f}m | Vel: {vel:.2f}m/s | TTC: {ttc:.1f}s | W_px: {w_px}")
            
            # Enviar MQTT
            # Telemetria
            mqtt_client.publish(TOPIC_RADAR, json.dumps({
                "source": source, "dist_m": round(final_dist, 2), 
                "vel_ms": round(vel, 2), "ttc": round(ttc, 1)
            }))
            
            # Alerta
            alert_level = "GREEN"
            msg = "LIVRE"
            if ttc < 1.5: 
                alert_level = "RED"; msg = "TRAVA!"
            elif ttc < 3.0: 
                alert_level = "YELLOW"; msg = "ATENCAO"
            
            mqtt_client.publish(TOPIC_ALERTA, json.dumps({
                "alert_level": alert_level, "msg": msg, 
                "dist_m": round(final_dist, 2), "ttc_s": round(ttc, 1)
            }))
            
        time.sleep(0.1) # 10Hz

except KeyboardInterrupt:
    GPIO.cleanup()
