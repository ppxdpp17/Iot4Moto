#!/usr/bin/env python3
# FCW Gateway - Raspberry Pi (Versão Consolidada)
# ----------------------------------------------------
# Obtém detecção da camera Unit-V2 via JSON (/func/result)
# Faz fallback para parsing MJPEG
# Calcula pseudo-distância, TTC e envia via MQTT
# ----------------------------------------------------

import time
import math
import json
import threading
from collections import deque
import requests
import paho.mqtt.client as mqtt
import RPi.GPIO as GPIO
import numpy as np
import cv2

# ---------------- CONFIGURAÇÕES ----------------
CAM_SNAPSHOT_URL = "http://10.254.239.1/video_feed"
FUNC_RESULT_URL = "http://10.254.239.1/func/result"

MQTT_BROKER = "172.20.0.130"
TOPIC_RADAR = "fcw/radar"
TOPIC_ALERTA = "fcw/alerta"

USE_HC_SR04 = True
TRIG_PIN = 23
ECHO_PIN = 24
SWITCH_TO_ULTRASOUND_M = 3.5

CALIB_SCALE = 800.0
ASSUMED_FRAME_WIDTH = 640

ALERT_TTC_YELLOW = 5.0
ALERT_TTC_RED = 3.0
HISTORY_SIZE = 10

# ---------------- SETUP DE HARDWARE ----------------
GPIO.setmode(GPIO.BCM)
GPIO.setup(TRIG_PIN, GPIO.OUT)
GPIO.setup(ECHO_PIN, GPIO.IN)
GPIO.output(TRIG_PIN, False)

def read_hcsr04():
    try:
        GPIO.output(TRIG_PIN, True)
        time.sleep(0.00001)
        GPIO.output(TRIG_PIN, False)

        pulse_start = time.time()
        timeout = pulse_start + 0.02
        while GPIO.input(ECHO_PIN) == 0 and time.time() < timeout:
            pulse_start = time.time()

        pulse_end = time.time()
        timeout = pulse_end + 0.02
        while GPIO.input(ECHO_PIN) == 1 and time.time() < timeout:
            pulse_end = time.time()

        pulse_duration = pulse_end - pulse_start
        dist = pulse_duration * 17150
        return dist / 100.0
    except:
        return None

# ---------------- MQTT ----------------
mqtt_client = mqtt.Client()
mqtt_client.connect(MQTT_BROKER, 1883, 60)
mqtt_client.loop_start()

def publish_radar(dist_m, vel_ms, ttc, source):
    payload = json.dumps({
        "source": source,
        "dist_m": dist_m,
        "vel_ms": vel_ms,
        "ttc": ttc
    })
    mqtt_client.publish(TOPIC_RADAR, payload)


def publish_alert(level, msg, dist, ttc, source):
    payload = json.dumps({
        "alert_level": level,
        "msg": msg,
        "dist_m": dist,
        "ttc_s": ttc,
        "source": source
    })
    mqtt_client.publish(TOPIC_ALERTA, payload)

# ---------------- JSON + MJPEG CAMERA ----------------
sess = requests.Session()
_mjpeg_iter_local = None


def fetch_detection_json(timeout=1.5):
    try:
        r = sess.get(FUNC_RESULT_URL, timeout=timeout)
        if r.status_code == 200:
            return r.json()
        return None
    except:
        return None


def mjpeg_next_frame(url, timeout=8):
    global _mjpeg_iter_local
    if _mjpeg_iter_local is None:
        try:
            r = sess.get(url, stream=True, timeout=timeout)
            _buf = b""
            def generator():
                nonlocal r, _buf
                try:
                    for chunk in r.iter_content(chunk_size=1024):
                        if not chunk:
                            continue
                        _buf += chunk
                        while True:
                            start = _buf.find(b"\xff\xd8")
                            if start == -1: break
                            end = _buf.find(b"\xff\xd9", start)
                            if end == -1: break
                            jpg = _buf[start:end+2]
                            _buf = _buf[end+2:]
                            arr = np.frombuffer(jpg, dtype=np.uint8)
                            img = cv2.imdecode(arr, cv2.IMREAD_COLOR)
                            yield img
                finally:
                    r.close()
            _mjpeg_iter_local = generator()
        except:
            _mjpeg_iter_local = None
            return None
    try:
        return next(_mjpeg_iter_local)
    except:
        _mjpeg_iter_local = None
        return None


# ---------------- Simples detecção (fallback) ----------------

def detect_car_bbox(frame):
    gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
    _, th = cv2.threshold(gray, 200, 255, cv2.THRESH_BINARY)
    cnts, _ = cv2.findContours(th, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
    if not cnts:
        return None
    c = max(cnts, key=cv2.contourArea)
    if cv2.contourArea(c) < 80:
        return None
    x, y, w, h = cv2.boundingRect(c)
    return (x, y, w, h)

def bbox_width_pixels(bbox):
    return bbox[2]


# ---------------- Obter bbox (preferindo JSON) ----------------

def get_bbox_from_camera():
    j = fetch_detection_json()
    if j:
        objs = j.get("obj", [])
        if objs:
            best = max(objs, key=lambda o: o.get("prob", 0))
            w = best.get("w")
            if w:
                return {"source": "camera_json", "bbox_w": float(w), "frame": None}

    frame = mjpeg_next_frame(CAM_SNAPSHOT_URL)
    if frame is not None:
        bbox = detect_car_bbox(frame)
        if bbox:
            wpx = bbox_width_pixels(bbox)
            return {"source": "camera_mjpeg", "bbox_w": float(wpx), "frame": frame}
    return None

# ---------------- TTC ----------------

def compute_ttc_from_history(hist):
    if len(hist) < 3:
        return None
    (w1, t1), (w2, t2) = hist[-2], hist[-1]
    if w2 >= w1:
        return None
    return 0.5

# ---------------- MAIN LOOP ----------------

def main():
    history = deque(maxlen=HISTORY_SIZE)
    print("FCW Gateway iniciado...")

    while True:
        info = get_bbox_from_camera()

        if info is None:
            publish_alert("GREEN", "CAMINHO LIVRE", None, None, "none")
            history.clear()
            time.sleep(0.15)
            continue

        src = info["source"]
        bbox_w = info["bbox_w"]
        fw = ASSUMED_FRAME_WIDTH
        if info.get("frame") is not None:
            fw = info["frame"].shape[1]

        pseudo_dist = (CALIB_SCALE / bbox_w) if bbox_w > 0 else None

        history.append((bbox_w, time.time()))
        ttc_est = compute_ttc_from_history(list(history))

        if pseudo_dist is not None and pseudo_dist <= SWITCH_TO_ULTRASOUND_M and USE_HC_SR04:
            us = read_hcsr04()
            if us:
                dist_m = us
                source = "ultrasonic"
            else:
                dist_m = pseudo_dist
                source = src
        else:
            dist_m = pseudo_dist
            source = src

        publish_radar(dist_m, None, ttc_est, source)

        if ttc_est is not None:
            if ttc_est <= ALERT_TTC_RED:
                publish_alert("RED", "RISCO IMEDIATO - TRAVA!", dist_m, ttc_est, source)
            elif ttc_est <= ALERT_TTC_YELLOW:
                publish_alert("YELLOW", "ATENÇÃO - FECHAR", dist_m, ttc_est, source)
            else:
                publish_alert("GREEN", "CAMINHO LIVRE", dist_m, ttc_est, source)
        else:
            publish_alert("GREEN", "CAMINHO LIVRE", dist_m, None, source)

        time.sleep(0.15)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        GPIO.cleanup()
        print("\nEncerrado pelo utilizador.")
