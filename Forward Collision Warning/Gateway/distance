# fcw_sensor.py - Raspberry Pi
import RPi.GPIO as GPIO
import time
import json
import paho.mqtt.client as mqtt

# --- CONFIGURAÇÃO ---
# Ajusta o IP para o do teu PC Windows
MQTT_BROKER = "10.10.9.216"
MQTT_PORT = 1883
TOPIC_PUB = "fcw/radar"

# Pinos GPIO (BCM)
TRIG = 23
ECHO = 24

# --- SETUP ---
GPIO.setmode(GPIO.BCM)
GPIO.setup(TRIG, GPIO.OUT)
GPIO.setup(ECHO, GPIO.IN)

client = mqtt.Client(mqtt.CallbackAPIVersion.VERSION1, "Moto_Sensor_FCW")

def get_distance():
    # Envia pulso de 10us
    GPIO.output(TRIG, True)
    time.sleep(0.00001)
    GPIO.output(TRIG, False)

    start_time = time.time()
    stop_time = time.time()

    # Timeout de segurança
    timeout = start_time + 0.04

    # Espera pelo eco (Low -> High)
    while GPIO.input(ECHO) == 0:
        start_time = time.time()
        if start_time > timeout: return -1

    # Espera pelo fim do eco (High -> Low)
    while GPIO.input(ECHO) == 1:
        stop_time = time.time()
        if stop_time > timeout: return -1

    elapsed = stop_time - start_time
    distance = (elapsed * 34300) / 2 # Velocidade som 343m/s
    return round(distance, 2)

# --- LOOP PRINCIPAL ---
try:
    print(f"A conectar ao broker {MQTT_BROKER}...")
    client.connect(MQTT_BROKER, MQTT_PORT, 60)
    client.loop_start()
    print("Sensor FCW Ativo. A monitorizar...")

    while True:
        dist = get_distance()

        # Filtra erros e distâncias irrelevantes (> 200cm)
        if 2 < dist < 30:
            payload = {
                "ts": time.time(),
                "dist": dist
            }
            client.publish(TOPIC_PUB, json.dumps(payload), qos=0)
            # Alta frequência de envio quando há obstáculo
            time.sleep(0.05)
        else:
            # Baixa frequência quando caminho está livre
            time.sleep(0.5)

except KeyboardInterrupt:
    print("\nParado.")
except Exception as e:
    print(f"Erro: {e}")
finally:
    GPIO.cleanup()
    client.loop_stop()
    client.disconnect()
