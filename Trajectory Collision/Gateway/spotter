import paho.mqtt.client as mqtt
import json
import time
import requests # Para falar com a API da UnitV2
import math

# --- CONFIGURAÇÃO ---
MQTT_BROKER = "172.20.0.130" # IP DO TEU PC
TOPIC_PUB = "percepcao/A"

# URL da API da UnitV2 (Ajusta o IP se mudaste)
# A UnitV2 geralmente expõe o resultado da função atual em:
UNITV2_API_URL = "http://10.254.239.1/func/result"
# Se não funcionar, tenta: "http://10.254.239.1/v1/func/result"

# Calibração da Distância
# Largura real do brinquedo (metros)
LARGURA_REAL_OBJ = 0.20 
# Distância Focal (Calibrar: colocar objeto a 1m, ver largura em pixels. F = (P*D)/W)
FOCAL_LENGTH = 500.0 

# Posição Fixa do Veículo A (Cruzamento)
LAT_A = 40.0000
LON_A = 8.0000

def get_camera_data():
    try:
        # Pede o JSON à câmara
        r = requests.get(UNITV2_API_URL, timeout=0.5)
        if r.status_code == 200:
            return r.json()
    except Exception as e:
        # print(f"Erro ler câmara: {e}")
        pass
    return None

def on_connect(client, userdata, flags, rc):
    print("Veículo A (Gateway) conectado ao MQTT.")

client = mqtt.Client(mqtt.CallbackAPIVersion.VERSION1, "VeiculoA_Rpi_UnitV2")
client.on_connect = on_connect

try:
    client.connect(MQTT_BROKER, 1883, 60)
    client.loop_start()
    
    print("A ler dados da UnitV2 e a publicar...")

    while True:
        data = get_camera_data()
        
        # A estrutura do JSON da UnitV2 depende do modo, mas geralmente é algo como:
        # {'running': 'Object Detection', 'num': 1, 'result': [{'x': 100, 'y': 50, 'w': 40, 'h': 30, 'prob': 0.9, 'class': 'car'}]}
        
        if data and 'result' in data and len(data['result']) > 0:
            # Pegar no maior objeto detetado
            obj = data['result'][0] 
            
            # Filtrar por confiança (opcional)
            if obj.get('prob', 0) > 0.3:
                w_pixels = obj.get('w', 1)
                
                # 1. Calcular Distância
                distancia = (LARGURA_REAL_OBJ * FOCAL_LENGTH) / w_pixels
                
                # 2. Preparar Payload V2V
                payload = {
                    "ts": time.time(),
                    "lat_observador": LAT_A,
                    "lon_observador": LON_A,
                    "objeto_detectado": obj.get('class', 'desconhecido'),
                    "distancia_estimada": round(distancia, 2),
                    # Simular um ângulo baseado no 'x' da imagem (centro vs esquerda/direita)
                    "posicao_x_imagem": obj.get('x') 
                }
                
                client.publish(TOPIC_PUB, json.dumps(payload), qos=0)
                print(f"Detetado: {payload['objeto_detectado']} a {distancia:.2f}m")
        
        # Alta frequência (10Hz a 20Hz é bom para V2V)
        time.sleep(0.1)

except KeyboardInterrupt:
    print("Parado.")
finally:
    client.loop_stop()
    client.disconnect()
