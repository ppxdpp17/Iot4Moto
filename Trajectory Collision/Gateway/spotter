import requests
import json
import time
import paho.mqtt.client as mqtt
from kalman_filter import KalmanFilter

# --- CONFIGURAÇÃO ---
MQTT_BROKER = "172.20.0.130" # IP DO PC
TOPIC_V2X_OBJECTS = "v2x/cruzamento/objetos"

# Câmara UnitV2
UNITV2_URL = "http://10.254.239.1/func/result"
REAL_WIDTH_OBJ = 0.035  # 3.5cm (Largura do carrinho)
FOCAL_LENGTH = 457.0    # O valor que calibraste

# Inicializar Kalman (Começa a assumir que o carro está a 2m)
kf = KalmanFilter(initial_value=2.0)

# Sessão HTTP
session = requests.Session()

def get_camera_data():
    """Lê stream da UnitV2"""
    try:
        with session.post(UNITV2_URL, data={}, stream=True, timeout=0.5) as r:
            if r.status_code != 200: return None
            
            buffer = ""
            for chunk in r.iter_content(chunk_size=1):
                if chunk:
                    char = chunk.decode('utf-8', errors='ignore')
                    buffer += char
                    if char == '}':
                        start_idx = buffer.rfind('{')
                        if start_idx != -1:
                            try:
                                data = json.loads(buffer[start_idx:])
                                # Suporta 'obj', 'result', ou 'rect'
                                objs = data.get('obj', data.get('rect', data.get('result')))
                                
                                if isinstance(objs, dict): objs = [objs] # Normaliza lista
                                
                                if objs and len(objs) > 0:
                                    # Pega no maior objeto
                                    best = max(objs, key=lambda x: x.get('w', 0))
                                    return best.get('w', 0)
                            except: pass
                        if len(buffer) > 200: break
    except: pass
    return None

# --- MAIN ---
client = mqtt.Client(mqtt.CallbackAPIVersion.VERSION1, "RSU_Camera_Pi")
client.connect(MQTT_BROKER, 1883, 60)
client.loop_start()

print("RSU (Infraestrutura) Iniciada.")

try:
    while True:
        # 1. Ler Câmara
        w_px = get_camera_data()
        
        if w_px and w_px > 5:
            # 2. Calcular Distância Bruta (Raw)
            dist_raw = (REAL_WIDTH_OBJ * FOCAL_LENGTH) / w_px
            
            # 3. Suavizar com Kalman
            dist_smooth = kf.update(dist_raw)
            
            # 4. Mapear para Coordenadas do Cruzamento
            # O carro vem de baixo (Y negativo) para o centro (0)
            # Posição Y = -Distância
            pos_y = -dist_smooth
            
            # 5. Publicar Mensagem V2X (CAM - Cooperative Awareness Message)
            payload = {
                "id": "VEHICLE_C",
                "ts": time.time(),
                "pos_x": 0.0,      # Está na via vertical
                "pos_y": round(pos_y, 2),
                "speed_ms": 0.0,   # Poderíamos calcular delta, mas simplificamos
                "lane": "SOUTH_ENTRY"
            }
            
            client.publish(TOPIC_V2X_OBJECTS, json.dumps(payload), qos=0)
            print(f"📡 V2X Broadcast: Carro C em Y={pos_y:.2f}m (Raw={dist_raw:.2f}m)")
            
        time.sleep(0.1) # 10Hz Update Rate

except KeyboardInterrupt:
    print("Parado.")
    client.disconnect()
